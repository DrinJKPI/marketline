# Copy this file to `.env` and fill in the values.
# Never commit your real `.env` file.

# --- DynamoDB ---
# Development uses DynamoDB Local on your computer. For real AWS (Day 8),
# delete DYNAMODB_ENDPOINT and use the access keys of an IAM user instead.
DYNAMODB_REGION="eu-west-1"
DYNAMODB_ENDPOINT="http://localhost:8000"
DYNAMODB_TABLE_NAME="marketline"

# DynamoDB Local accepts any letters and numbers here. They are not real keys.
DYNAMODB_ACCESS_KEY_ID="local"
DYNAMODB_SECRET_ACCESS_KEY="local"