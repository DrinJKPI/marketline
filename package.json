{
  "name": "marketline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:ping": "tsx --env-file=.env --conditions=react-server scripts/db-ping.ts",
    "db:setup": "tsx --env-file=.env --conditions=react-server scripts/db-setup.ts",
    "db:reset": "tsx --env-file=.env --conditions=react-server scripts/db-setup.ts --reset",
    "db:seed": "tsx --env-file=.env --conditions=react-server scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1162.0",
    "geist": "^1.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }

}